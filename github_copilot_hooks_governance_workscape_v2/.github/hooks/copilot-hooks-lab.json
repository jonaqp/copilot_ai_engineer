{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "command": "python .github/hooks/scripts/hook_handler.py sessionStart",
        "timeoutSec": 10
      }
    ],
    "userPromptSubmitted": [
      {
        "type": "command",
        "command": "python .github/hooks/scripts/hook_handler.py userPromptSubmitted",
        "timeoutSec": 10
      }
    ],
    "preToolUse": [
      {
        "type": "command",
        "matcher": "bash|powershell|edit|create",
        "command": "python .github/hooks/scripts/hook_handler.py preToolUse",
        "timeoutSec": 10
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "matcher": "bash|powershell|edit|create",
        "command": "python .github/hooks/scripts/hook_handler.py postToolUse",
        "timeoutSec": 10
      }
    ],
    "postToolUseFailure": [
      {
        "type": "command",
        "command": "python .github/hooks/scripts/hook_handler.py postToolUseFailure",
        "timeoutSec": 10
      }
    ],
    "subagentStart": [
      {
        "type": "command",
        "command": "python .github/hooks/scripts/hook_handler.py subagentStart",
        "timeoutSec": 10
      }
    ],
    "subagentStop": [
      {
        "type": "command",
        "command": "python .github/hooks/scripts/hook_handler.py subagentStop",
        "timeoutSec": 10
      }
    ],
    "agentStop": [
      {
        "type": "command",
        "command": "python .github/hooks/scripts/hook_handler.py agentStop",
        "timeoutSec": 20
      }
    ],
    "errorOccurred": [
      {
        "type": "command",
        "command": "python .github/hooks/scripts/hook_handler.py errorOccurred",
        "timeoutSec": 10
      }
    ],
    "sessionEnd": [
      {
        "type": "command",
        "command": "python .github/hooks/scripts/hook_handler.py sessionEnd",
        "timeoutSec": 10
      }
    ],
    "notification": [
      {
        "type": "command",
        "command": "python .github/hooks/scripts/hook_handler.py notification",
        "timeoutSec": 5
      }
    ],
    "preCompact": [
      {
        "type": "command",
        "command": "python .github/hooks/scripts/hook_handler.py preCompact",
        "timeoutSec": 10
      }
    ],
    "permissionRequest": [
      {
        "type": "command",
        "matcher": "bash|powershell|edit|create",
        "command": "python .github/hooks/scripts/hook_handler.py permissionRequest",
        "timeoutSec": 10
      }
    ]
  }
}
