PROGRAM ACCTUPD
INPUT ACCOUNT-RECORD
OUTPUT ACCOUNT-RECORD

BEGIN
  IF ACCT-STATUS = "C" THEN
     SET RETURN-CODE = 12
     SET MESSAGE = "ACCOUNT CLOSED"
     EXIT
  END-IF

  IF TXN-TYPE = "C" THEN
     SET ACCT-BALANCE = ACCT-BALANCE + TXN-AMOUNT
  ELSE
     IF TXN-TYPE = "D" THEN
        IF ACCT-BALANCE < TXN-AMOUNT THEN
           SET RETURN-CODE = 8
           SET MESSAGE = "INSUFFICIENT FUNDS"
           EXIT
        END-IF
        SET ACCT-BALANCE = ACCT-BALANCE - TXN-AMOUNT
     ELSE
        SET RETURN-CODE = 4
        SET MESSAGE = "INVALID TRANSACTION"
        EXIT
     END-IF
  END-IF

  SET RETURN-CODE = 0
  SET MESSAGE = "OK"
END
