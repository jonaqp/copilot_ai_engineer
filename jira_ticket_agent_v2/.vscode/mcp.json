{
  "mcpServers": {
    "mcp-atlassian": {
      "command": "uvx",
      "args": ["mcp-atlassian"],
      "env": {
        "JIRA_URL": "https://jira.globaldevtools.bbva.com",
        "JIRA_USERNAME": "jonathan.quiza",
